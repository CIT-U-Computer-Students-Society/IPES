# Copy this template to .env alongside it in the repository root.
# Django discovers it through python-decouple's parent-directory search.

# Security
# Set to True for development, False for production
DEBUG=True
SECRET_KEY=generate-a-secure-secret-key-here

# Database Configuration
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=require # Uncomment for Supabase/Production

# Supabase Storage (private avatars bucket)
# Used by Django for profile pictures; signed image URLs expire after one hour.
# Copy the endpoint and region from Supabase's S3 configuration page.
# Keep S3 credentials backend-only; never expose them in frontend environment files.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=your-region
AWS_STORAGE_BUCKET_NAME=avatars

# Networking (Production)
# Comma-separated lists
# ALLOWED_HOSTS=your-domain.com,another-domain.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.com

# Production cookies are Secure, HttpOnly and host-only.
# Production defaults to None for cross-site frontends; prefer Lax for same-site hosting.
# COOKIE_SAMESITE=Lax
# CSP_CONNECT_SRC=https://api.your-domain.com # Only if Django-hosted HTML uses a different API
