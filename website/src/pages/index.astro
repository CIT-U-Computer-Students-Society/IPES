  <!-- =========================================================================
       Interactive Scripts: Tab Switcher & Theme Toggle
       ========================================================================= -->
  <script is:inline>
    // Theme Toggle Handler
    const toggleBtn = document.getElementById('theme-toggle-btn');
    toggleBtn?.addEventListener('click', () => {
      const isCurrentlyDark = document.documentElement.classList.contains('dark');
      const nextDark = !isCurrentlyDark;
      document.documentElement.classList.toggle('dark', nextDark);
      document.documentElement.dataset.theme = nextDark ? 'dark' : 'light';
      localStorage.setItem('starlight-theme', nextDark ? 'dark' : 'light');
      localStorage.setItem('theme', nextDark ? 'dark' : 'light');
    });

    // Guide Tab Switcher
    const tabOfficer = document.getElementById('tab-officer');
    const tabAdmin = document.getElementById('tab-admin');
    const panelOfficer = document.getElementById('panel-officer');
    const panelAdmin = document.getElementById('panel-admin');

    tabOfficer?.addEventListener('click', () => {
      panelOfficer?.classList.remove('hidden');
      panelAdmin?.classList.add('hidden');
      tabOfficer.className = 'px-6 py-2.5 rounded-lg text-sm font-bold bg-[#293f55] text-white transition-all';
      tabAdmin.className = 'px-6 py-2.5 rounded-lg text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-[#293f55] transition-all';
    });

    tabAdmin?.addEventListener('click', () => {
      panelAdmin?.classList.remove('hidden');
      panelOfficer?.classList.add('hidden');
      tabAdmin.className = 'px-6 py-2.5 rounded-lg text-sm font-bold bg-[#293f55] text-white transition-all';
      tabOfficer.className = 'px-6 py-2.5 rounded-lg text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-[#293f55] transition-all';
    });
  </script>

