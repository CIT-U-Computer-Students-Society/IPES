---
// index.astro — Official IPES Landing Page & Visual Documentation Portal
import ThreeDLogo from '../components/ThreeDLogo.astro';
import '../styles/custom.css';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IPES — Individual Performance Evaluation System | CIT-U SSG</title>
  <meta name="description" content="Modern, automated peer evaluations and accomplishment portfolios for student organizations at Cebu Institute of Technology - University." />
  <link rel="icon" type="image/svg+xml" href="/IPES/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
  
  <script is:inline>
    // Theme initialization matching main IPES app
    const storedTheme = typeof localStorage !== 'undefined' && (localStorage.getItem('starlight-theme') || localStorage.getItem('theme'));
    const isDark = storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
  </script>
</head>

<body class="bg-[#f8fafc] dark:bg-[#0b0f19] text-[#0f172a] dark:text-[#f8fafc] font-['Inter',system-ui,sans-serif] antialiased transition-colors duration-200">

  <!-- =========================================================================
       Navigation Header
       ========================================================================= -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 dark:bg-[#0f172a]/85 border-b border-slate-200/80 dark:border-slate-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="/IPES/" class="flex items-center gap-3 group">
        <img src="/IPES/ipes-logo-colored.svg" alt="IPES Logo" class="w-8 h-8 object-contain transition-transform group-hover:scale-105" />
        <span class="text-xl font-bold tracking-tight text-[#293f55] dark:text-white font-['Montserrat',sans-serif]">IPES</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600 dark:text-slate-300">
        <a href="#overview" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">Overview</a>
        <a href="#comparison" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">Comparison</a>
        <a href="#features" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">Capabilities</a>
        <a href="#guides" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">User Guides</a>
        <a href="#faq" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">FAQ</a>
        <a href="/IPES/overview/" class="hover:text-[#293f55] dark:hover:text-[#f59e0b] transition-colors">Documentation &rarr;</a>
      </nav>

      <!-- Right Action Triggers -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle -->
        <button 
          id="theme-toggle-btn"
          type="button" 
          aria-label="Toggle theme" 
          class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="sun-icon" class="w-5 h-5 hidden dark:block text-[#f59e0b]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="moon-icon" class="w-5 h-5 block dark:hidden text-[#293f55]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <!-- Launch Portal CTA -->
        <a
          href="https://ipes.cc/login"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#293f55] hover:bg-[#1b2a4a] text-white font-semibold text-xs sm:text-sm shadow-sm hover:shadow transition-all"
        >
          <span>Launch App</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       Hero Section (Two-Column Layout with 3D Rotating Logo)
       ========================================================================= -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    <!-- Ambient Radial Glows -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-[#f59e0b]/10 via-[#293f55]/5 to-transparent blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Column: Copy & Actions -->
        <div class="lg:col-span-6 text-center lg:text-left space-y-6">
          <!-- Main Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0f172a] dark:text-white font-['Montserrat',sans-serif] leading-[1.12]">
            Transform Peer Evaluations Into <span class="text-[#f59e0b]">Actionable Growth</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
            A dedicated, purpose-built platform replacing fragmented Google Forms with dynamic assignment rules, verified accomplishment portfolios, and real-time performance analytics for CIT-University student organizations.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a 
              href="#guides" 
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#293f55] hover:bg-[#1b2a4a] text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2.5"
            >
              <span>Explore User Guides</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>

            <a
              href="https://ipes.cc/login"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:border-[#f59e0b] text-slate-800 dark:text-slate-200 font-semibold text-sm shadow-sm hover:shadow transition-all flex items-center justify-center gap-2"
            >
              <span>Sign In to IPES</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>

        <!-- Right Column: Interactive 3D Extruded Wireframe Logo -->
        <div class="lg:col-span-6 flex justify-center items-center relative">
          <ThreeDLogo />
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       Institutional Partners / Trust Bar
       ========================================================================= -->
  <section class="border-y border-slate-200/80 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-around gap-8 text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400">
        <div class="flex items-center gap-3">
          <img src="/IPES/ssg-logo.svg" alt="CIT-U SSG Logo" class="w-9 h-9 object-contain" />
          <span>CIT-U Supreme Student Government (SSG)</span>
        </div>
        <div class="flex items-center gap-3">
          <img src="/IPES/css-logo.svg" alt="Computer Students Society" class="w-9 h-9 object-contain" />
          <span>Computer Students Society (CSS)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       The Paradigm Shift: Before vs. After Comparison
       ========================================================================= -->
  <section id="comparison" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#f59e0b] mb-2 font-['Montserrat',sans-serif]">The Paradigm Shift</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-[#0f172a] dark:text-white font-['Montserrat',sans-serif]">
        Why Student Organizations Choose IPES
      </h3>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
        Manual evaluations through Google Forms and spreadsheets create administrative bottlenecks, calculation errors, and privacy concerns.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- The Legacy Way -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-red-200 dark:border-red-900/40 shadow-sm relative overflow-hidden">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-400 font-bold text-xs mb-6">
          <span>❌ The Legacy Way (Google Forms &amp; Sheets)</span>
        </div>
        <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-base leading-none">✕</span>
            <span><strong>Manual Distribution:</strong> Duplicating forms for every single committee, with a high risk of misrouting links to wrong members.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-base leading-none">✕</span>
            <span><strong>Scattered Proof:</strong> Unstructured accomplishment files sent over chats, making systematic validation impossible.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-base leading-none">✕</span>
            <span><strong>Spreadsheet Calculation Delay:</strong> Weeks of manual formula maintenance, cross-referencing, and potential tally errors.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-base leading-none">✕</span>
            <span><strong>Exposed Identities:</strong> Evaluator email addresses visible to form owners, discouraging honest, constructive feedback.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 font-bold text-base leading-none">✕</span>
            <span><strong>Zero Audit Trail:</strong> No immutable proof of when entries were modified, submitted, or released.</span>
          </li>
        </ul>
      </div>

      <!-- The IPES Platform -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border-2 border-[#293f55] dark:border-[#f59e0b] shadow-lg relative overflow-hidden">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#293f55]/10 dark:bg-[#f59e0b]/20 text-[#293f55] dark:text-[#f59e0b] font-bold text-xs mb-6">
          <span>✨ The IPES Platform (Modern &amp; Automated)</span>
        </div>
        <ul class="space-y-4 text-sm text-slate-700 dark:text-slate-200">
          <li class="flex items-start gap-3">
            <span class="text-[#10b981] font-bold text-base leading-none">✓</span>
            <span><strong>Automated Rule Engine:</strong> Declarative assignment rules (Peer-to-Peer, All-to-Head) generate exact evaluator-evaluatee pairs automatically.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#10b981] font-bold text-base leading-none">✓</span>
            <span><strong>Verified Portfolios:</strong> Officers log achievements with verifiable Google Drive proof links, reviewed before scores close.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#10b981] font-bold text-base leading-none">✓</span>
            <span><strong>Instant Multi-Axis Analytics:</strong> Real-time radar charts, competency category averages, and statistical percentiles published in one click.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#10b981] font-bold text-base leading-none">✓</span>
            <span><strong>True Confidentiality:</strong> Database-level anonymization decouples evaluator identities from scores and remarks.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#10b981] font-bold text-base leading-none">✓</span>
            <span><strong>Immutable Audit Trail:</strong> Append-only security logging records every form edit, role change, and result release with IP attribution.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       Core Capabilities Grid
       ========================================================================= -->
  <section id="features" class="py-20 bg-slate-50/50 dark:bg-slate-900/20 border-t border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#f59e0b] mb-2 font-['Montserrat',sans-serif]">Platform Features</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-[#0f172a] dark:text-white font-['Montserrat',sans-serif]">
          Everything Student Leadership Requires
        </h3>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
          Engineered for organizational scale, fairness, and accountability.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Feature 1: Rules Engine -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 rounded-xl bg-[#eef4f9] dark:bg-[#1b2a4a] text-[#293f55] dark:text-[#f59e0b] flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
          </div>
          <h4 class="text-base font-bold text-[#0f172a] dark:text-white mb-2 font-['Montserrat',sans-serif]">Dynamic Assignment Rules</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Configure declarative filters (Peer-to-Peer within unit, All-to-Head, Head-to-All) that generate individualized queues instantly.
          </p>
        </div>

        <!-- Feature 2: Portfolio -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 rounded-xl bg-[#fff7ed] dark:bg-[#291800] text-[#f59e0b] flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          </div>
          <h4 class="text-base font-bold text-[#0f172a] dark:text-white mb-2 font-['Montserrat',sans-serif]">Accomplishment Portfolio</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Officers log achievements with verifiable Google Drive proof links, audited by admins before scorecards are released.
          </p>
        </div>

        <!-- Feature 3: Analytics -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 rounded-xl bg-[#eef4f9] dark:bg-[#1b2a4a] text-[#293f55] dark:text-[#f59e0b] flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </div>
          <h4 class="text-base font-bold text-[#0f172a] dark:text-white mb-2 font-['Montserrat',sans-serif]">Radar Chart Analytics</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Gain multi-axis insights across Leadership, Execution, and Communication with statistical percentile ranking.
          </p>
        </div>

        <!-- Feature 4: Anonymity & Audit -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 rounded-xl bg-[#ecfdf5] dark:bg-[#064e3b] text-[#10b981] flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h4 class="text-base font-bold text-[#0f172a] dark:text-white mb-2 font-['Montserrat',sans-serif]">Confidentiality &amp; Audit</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Database-level anonymization protects evaluator honesty, paired with an append-only audit trail logging every admin action.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       How It Works: 3 Steps
       ========================================================================= -->
  <section id="workflow" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#f59e0b] mb-2 font-['Montserrat',sans-serif]">Evaluation Lifecycle</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-[#0f172a] dark:text-white font-['Montserrat',sans-serif]">
        How IPES Works in 3 Simple Steps
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Step 1 -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm relative">
        <div class="w-10 h-10 rounded-full bg-[#f59e0b] text-white font-bold flex items-center justify-center text-sm mb-6">1</div>
        <h4 class="text-lg font-bold text-[#0f172a] dark:text-white mb-3 font-['Montserrat',sans-serif]">Configure &amp; Assign</h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Admins define committee units, positions, competency rubrics, and Likert questions. Declarative assignment rules dynamically map evaluators to evaluatees.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm relative">
        <div class="w-10 h-10 rounded-full bg-[#293f55] text-white font-bold flex items-center justify-center text-sm mb-6">2</div>
        <h4 class="text-lg font-bold text-[#0f172a] dark:text-white mb-3 font-['Montserrat',sans-serif]">Evaluate &amp; Verify</h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Officers answer evaluations on an intuitive 1-5 Likert scale with qualitative remarks, and submit portfolio achievements with Google Drive proof links.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm relative">
        <div class="w-10 h-10 rounded-full bg-[#10b981] text-white font-bold flex items-center justify-center text-sm mb-6">3</div>
        <h4 class="text-lg font-bold text-[#0f172a] dark:text-white mb-3 font-['Montserrat',sans-serif]">Analyze &amp; Grow</h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Admins release the cycle. Officers immediately receive individualized scorecards, multi-axis radar charts, and anonymous peer feedback to foster leadership growth.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       Visual User Guide Showcase (With Annotated Light Mode Screenshots)
       ========================================================================= -->
  <section id="guides" class="py-20 bg-slate-50/70 dark:bg-slate-900/40 border-t border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[#f59e0b] mb-2 font-['Montserrat',sans-serif]">Interactive Visual Manuals</h2>
        <h3 class="text-3xl sm:text-4xl font-extrabold text-[#0f172a] dark:text-white font-['Montserrat',sans-serif]">
          Annotated User Instructions
        </h3>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
          Step-by-step instructions annotated with directional arrows and numbered action badges matching tldraw visual standards.
        </p>
      </div>

      <!-- Guide Track Selector Tabs -->
