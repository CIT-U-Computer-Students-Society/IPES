---
// ThreeDLogo.astro — Dynamic 3D IPES Logo (Normal Solid in Light Mode, Glowing Wireframe in Dark Mode)
interface Props {
  size?: number;
}
---

<div id="ipes-3d-wrapper" class="relative w-full max-w-[520px] aspect-square flex items-center justify-center select-none">
  <!-- Ambient Volumetric Glow behind the 3D Model with smooth CSS transition -->
  <div id="ipes-3d-glow" class="absolute inset-0 rounded-full bg-gradient-to-tr from-[#f59e0b]/20 via-[#293f55]/15 to-transparent blur-3xl pointer-events-none -z-10 transition-all duration-700"></div>

  <!-- Three.js Canvas -->
  <canvas id="ipes-3d-canvas" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { SVGLoader } from 'three/examples/jsm/loaders/SVGLoader.js';

  const container = document.getElementById('ipes-3d-wrapper');
  const canvas = document.getElementById('ipes-3d-canvas') as HTMLCanvasElement | null;
  const glow = document.getElementById('ipes-3d-glow');

  if (container && canvas) {
    const scene = new THREE.Scene();

    const width = container.clientWidth || 480;
    const height = container.clientHeight || 480;

    const camera = new THREE.PerspectiveCamera(38, width / height, 1, 3000);
    camera.position.set(0, 0, 780);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Dynamic Lights with smooth interpolation between light & dark themes
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.25);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xfffbeb, 2.4);
    keyLight.position.set(280, 360, 420);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xe2e8f0, 1.3);
    fillLight.position.set(-280, -260, 360);
    scene.add(fillLight);

    const rimLight = new THREE.PointLight(0xffffff, 1.1, 1400);
    rimLight.position.set(0, 0, 520);
    scene.add(rimLight);

    // Root group for the 3D model
    const logoGroup = new THREE.Group();
    scene.add(logoGroup);

    interface PartRecord {
      mesh: THREE.Mesh;
      solidMat: THREE.MeshPhysicalMaterial;
      edgeLines: THREE.LineSegments;
      edgeMat: THREE.LineBasicMaterial;
      wireLines: THREE.LineSegments;
      wireMat: THREE.LineBasicMaterial;
      lightSolidColor: THREE.Color;
      darkSolidColor: THREE.Color;
      lightEdgeColor: THREE.Color;
      darkEdgeColor: THREE.Color;
      lightWireColor: THREE.Color;
      darkWireColor: THREE.Color;
      darkEdgeOpacity: number;
      darkWireOpacity: number;
      darkSolidOpacity: number;
    }

    const parts: PartRecord[] = [];

    const getIsDark = () =>
      document.documentElement.classList.contains('dark') ||
      document.documentElement.dataset.theme === 'dark';

    let currentT = getIsDark() ? 1.0 : 0.0;
    let targetT = currentT;

    const applyTheme = (t: number) => {
      // 0 = Light Mode (Normal Solid 3D), 1 = Dark Mode (Glowing Wireframe 3D)

      // 1. Ambient & Directional Lighting
      ambientLight.color.lerpColors(new THREE.Color(0xffffff), new THREE.Color(0x1e293b), t);
      ambientLight.intensity = THREE.MathUtils.lerp(1.25, 0.6, t);

      keyLight.color.lerpColors(new THREE.Color(0xfffbeb), new THREE.Color(0xf59e0b), t);
      keyLight.intensity = THREE.MathUtils.lerp(2.4, 2.0, t);

      fillLight.color.lerpColors(new THREE.Color(0xe2e8f0), new THREE.Color(0x0ea5e9), t);
      fillLight.intensity = THREE.MathUtils.lerp(1.3, 1.8, t);

      rimLight.color.lerpColors(new THREE.Color(0xffffff), new THREE.Color(0x38bdf8), t);
      rimLight.intensity = THREE.MathUtils.lerp(1.1, 1.4, t);

      // 2. Part Materials Interpolation
      for (const p of parts) {
        // Solid physical surface
        p.solidMat.color.lerpColors(p.lightSolidColor, p.darkSolidColor, t);
        p.solidMat.opacity = THREE.MathUtils.lerp(1.0, p.darkSolidOpacity, t);
        p.solidMat.roughness = THREE.MathUtils.lerp(0.28, 0.1, t);
        p.solidMat.metalness = THREE.MathUtils.lerp(0.2, 0.9, t);
        p.solidMat.clearcoat = THREE.MathUtils.lerp(0.4, 0.8, t);
        p.solidMat.depthWrite = t < 0.1;

        // Contour edge lines
        p.edgeMat.color.lerpColors(p.lightEdgeColor, p.darkEdgeColor, t);
        p.edgeMat.opacity = THREE.MathUtils.lerp(0.0, p.darkEdgeOpacity, t);
        p.edgeLines.visible = p.edgeMat.opacity > 0.01;

        // Wireframe structural grid
        p.wireMat.color.lerpColors(p.lightWireColor, p.darkWireColor, t);
        p.wireMat.opacity = THREE.MathUtils.lerp(0.0, p.darkWireOpacity, t);
        p.wireLines.visible = p.wireMat.opacity > 0.01;
      }

      // 3. Volumetric background glow class
      if (glow) {
        if (t > 0.5) {
          glow.className = "absolute inset-0 rounded-full bg-gradient-to-tr from-[#38bdf8]/25 via-[#f59e0b]/20 to-transparent blur-3xl pointer-events-none -z-10 transition-all duration-700";
        } else {
          glow.className = "absolute inset-0 rounded-full bg-gradient-to-tr from-[#f59e0b]/20 via-[#293f55]/15 to-transparent blur-3xl pointer-events-none -z-10 transition-all duration-700";
        }
      }
    };

    // Load and build the 3D model from SVG vector paths
    fetch('/ipes-logo-colored.svg')
      .then((res) => res.text())
      .then((svgText) => {
        const loader = new SVGLoader();
        const svgData = loader.parse(svgText);
        const tempGroup = new THREE.Group();

        svgData.paths.forEach((path, pathIndex) => {
          const shapes = SVGLoader.createShapes(path);

          shapes.forEach((shape) => {
            const isAmberGear = pathIndex === 0;
            const isNavyGear = pathIndex === 1;
            const isCheckmark = pathIndex === 2;

            const extrudeSettings = {
              depth: isCheckmark ? 65 : 50,
              bevelEnabled: true,
              bevelSegments: 3,
              steps: 1,
              bevelSize: isCheckmark ? 5 : 4,
              bevelThickness: isCheckmark ? 6 : 5,
            };

            const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);

            // 1. Solid physical surface (Opaque and polished in Light Mode, subtle dark glass in Dark Mode)
            const solidMat = new THREE.MeshPhysicalMaterial({
              transparent: true,
              opacity: 1.0,
              roughness: 0.28,
              metalness: 0.2,
              clearcoat: 0.4,
              clearcoatRoughness: 0.15,
              depthWrite: true,
              side: THREE.DoubleSide,
            });

            // 2. Crisp outer contour edges (Hidden in Light Mode, glowing in Dark Mode)
            const edgeGeo = new THREE.EdgesGeometry(geometry, 20);
            const edgeMat = new THREE.LineBasicMaterial({
              transparent: true,
              opacity: 0.0,
              depthWrite: false,
            });
            const edgeLines = new THREE.LineSegments(edgeGeo, edgeMat);
            edgeLines.visible = false;

            // 3. Structural wireframe triangulation grid (Hidden in Light Mode, luminous in Dark Mode)
            const wireGeo = new THREE.WireframeGeometry(geometry);
            const wireMat = new THREE.LineBasicMaterial({
              transparent: true,
              opacity: 0.0,
              depthWrite: false,
            });
            const wireLines = new THREE.LineSegments(wireGeo, wireMat);
            wireLines.visible = false;

            let lightSolidColor: THREE.Color;
            let darkSolidColor: THREE.Color;
            let lightEdgeColor: THREE.Color;
            let darkEdgeColor: THREE.Color;
            let lightWireColor: THREE.Color;
            let darkWireColor: THREE.Color;
            let darkEdgeOpacity: number;
            let darkWireOpacity: number;
            let darkSolidOpacity: number;

            if (isAmberGear) {
              // Upper Gear: Branded warm amber
              lightSolidColor = new THREE.Color(0xf59e0b);
              darkSolidColor = new THREE.Color(0xf59e0b);
              lightEdgeColor = new THREE.Color(0xd97706);
              darkEdgeColor = new THREE.Color(0xfbbf24);
              lightWireColor = new THREE.Color(0xf59e0b);
              darkWireColor = new THREE.Color(0xf59e0b);
              darkEdgeOpacity = 0.95;
              darkWireOpacity = 0.32;
              darkSolidOpacity = 0.12;
            } else if (isCheckmark) {
              // Checkmark: Deep slate navy in light, vivid electric cyan in dark
              lightSolidColor = new THREE.Color(0x1e293b);
              darkSolidColor = new THREE.Color(0x0284c7);
              lightEdgeColor = new THREE.Color(0x0f172a);
              darkEdgeColor = new THREE.Color(0x60a5fa);
              lightWireColor = new THREE.Color(0x293f55);
              darkWireColor = new THREE.Color(0x38bdf8);
              darkEdgeOpacity = 0.95;
              darkWireOpacity = 0.35;
              darkSolidOpacity = 0.14;
            } else {
              // Lower Gear: Classic IPES Navy in light, electric cyan in dark
              lightSolidColor = new THREE.Color(0x293f55);
              darkSolidColor = new THREE.Color(0x0284c7);
              lightEdgeColor = new THREE.Color(0x1b2a4a);
              darkEdgeColor = new THREE.Color(0x38bdf8);
              lightWireColor = new THREE.Color(0x293f55);
              darkWireColor = new THREE.Color(0x0284c7);
              darkEdgeOpacity = 0.95;
              darkWireOpacity = 0.28;
              darkSolidOpacity = 0.10;
            }

            const mesh = new THREE.Mesh(geometry, solidMat);
            const partGroup = new THREE.Group();
            partGroup.add(mesh);
            partGroup.add(edgeLines);
            partGroup.add(wireLines);

            // Z-Layering: Checkmark floats forward in front of the gear ring
            if (isCheckmark) {
              partGroup.position.z = 24;
            }

            tempGroup.add(partGroup);

            parts.push({
              mesh,
              solidMat,
              edgeLines,
              edgeMat,
              wireLines,
              wireMat,
              lightSolidColor,
              darkSolidColor,
              lightEdgeColor,
              darkEdgeColor,
              lightWireColor,
              darkWireColor,
              darkEdgeOpacity,
              darkWireOpacity,
              darkSolidOpacity,
            });
          });
        });

        // Compute Bounding Box to Center Logo around (0,0,0)
        const box = new THREE.Box3().setFromObject(tempGroup);
        const center = new THREE.Vector3();
        box.getCenter(center);
        const size = new THREE.Vector3();
        box.getSize(size);

        tempGroup.position.x = -center.x;
        tempGroup.position.y = -center.y;
        tempGroup.position.z = -center.z;

        logoGroup.add(tempGroup);

        // Normalize scale to fit viewer nicely and invert Y (SVG coordinate flip)
        const maxDim = Math.max(size.x, size.y);
        const targetScale = 450 / maxDim;
        logoGroup.scale.set(targetScale, -targetScale, targetScale);

        // Initial aesthetic tilt
        logoGroup.rotation.x = 0.15;
        logoGroup.rotation.y = -0.3;

        // Apply initial theme state immediately
        applyTheme(currentT);
      })
      .catch((err) => {
        console.warn('[3D Logo] SVG Load Error:', err);
      });

    // Theme mutation observer: smoothly transitions targetT
    const observer = new MutationObserver(() => {
      targetT = getIsDark() ? 1.0 : 0.0;
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class', 'data-theme'],
    });

    // Drag, Parallax & Inertia Physics
    let isDragging = false;
    let previousPointerX = 0;
    let previousPointerY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let targetTiltX = 0;
    let targetTiltY = 0;

    const onPointerDown = (e: PointerEvent) => {
      isDragging = true;
      previousPointerX = e.clientX;
      previousPointerY = e.clientY;
      velocityX = 0;
      velocityY = 0;
    };

    const onPointerMove = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const normX = (e.clientX - rect.left) / rect.width - 0.5;
      const normY = (e.clientY - rect.top) / rect.height - 0.5;
      targetTiltY = normX * 0.45;
      targetTiltX = -normY * 0.35;

      if (isDragging) {
        const deltaX = e.clientX - previousPointerX;
        const deltaY = e.clientY - previousPointerY;
        velocityX = deltaX * 0.007;
        velocityY = deltaY * 0.007;

        logoGroup.rotation.y += velocityX;
        logoGroup.rotation.x += velocityY;

        previousPointerX = e.clientX;
        previousPointerY = e.clientY;
      }
    };

    const onPointerUp = () => {
      isDragging = false;
    };

    canvas.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);

    // Responsive Canvas Resizing
    const resizeObserver = new ResizeObserver(() => {
      if (!container || !canvas) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });
    resizeObserver.observe(container);

    // Render loop with smooth theme transition & auto-rotation
    let clock = new THREE.Clock();

    const animate = () => {
      requestAnimationFrame(animate);

      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      // Smooth Theme Cross-Dissolve Lerp (approx 500ms)
      if (Math.abs(currentT - targetT) > 0.002) {
        currentT += (targetT - currentT) * 0.08;
        applyTheme(currentT);
      } else if (currentT !== targetT) {
        currentT = targetT;
        applyTheme(currentT);
      }

      if (!isDragging) {
        // Continuous smooth auto-rotation
        logoGroup.rotation.y += 0.007;

        // Gentle organic breathing float
        logoGroup.rotation.z = Math.sin(elapsed * 0.6) * 0.03;

        // Inertia damping
        velocityX *= 0.94;
        velocityY *= 0.94;
        logoGroup.rotation.y += velocityX;
        logoGroup.rotation.x += velocityY;

        // Subtle tilt interpolation toward pointer
        logoGroup.rotation.x += (targetTiltX - logoGroup.rotation.x) * 0.03;
      }

      renderer.render(scene, camera);
    };

    animate();
  }
</script>
